  "tips": [
    { "title": "Trains", "body": "Buy ICE tickets on bahn.de — 'Sparpreis' fares can be €19 if booked early. Validate nothing — just board." },
    { "title": "Cash", "body": "Many smaller restaurants and bakeries still only accept CASH. Always carry €50–100." },
    { "title": "Sundays", "body": "Almost ALL shops closed on Sundays (except in train stations). Plan groceries accordingly." },
    { "title": "Tipping", "body": "Round up or add 5–10%. Tell the server the total when paying, don't leave coins on the table." },
    { "title": "Tap water", "body": "Safe everywhere — but Germans rarely drink it. Asking for 'Leitungswasser' may get a raised eyebrow." },
    { "title": "Recycling", "body": "Pfand: bottles have a deposit (€0.08–0.25). Return at supermarket machines." },
    { "title": "Crossing streets", "body": "Germans wait for the green man even with no cars. Jaywalking gets dirty looks (and fines)." },
    { "title": "Connectivity", "body": "EU roaming works seamlessly with most EU SIMs. Buy a Vodafone CallYa or O2 prepaid SIM if from outside EU." }
  ],
